<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Nomes de teste em portugues com sublinhado sao intencionais. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\KillerSense.Core\KillerSense.Core.csproj" />
    <ProjectReference Include="..\..\src\KillerSense.Firmware\KillerSense.Firmware.csproj" />
    <ProjectReference Include="..\..\src\KillerSense.Ipc\KillerSense.Ipc.csproj" />
  </ItemGroup>
</Project>
