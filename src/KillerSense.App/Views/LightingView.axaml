<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KillerSense.App.ViewModels"
             x:Class="KillerSense.App.Views.LightingView"
             x:DataType="vm:LightingViewModel">
  <UserControl.Styles>
    <!-- Zona do desenho do teclado -->
    <Style Selector="Button.zone">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.zone:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource KsMutedBrush}" />
    </Style>
    <Style Selector="Button.zone.on /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource KsAccentBrush}" />
    </Style>
    <!-- Tecla desenhada: só o contorno escuro; o miolo mostra a cor da zona -->
    <Style Selector="Border.key">
      <Setter Property="Height" Value="22" />
      <Setter Property="BorderBrush" Value="#141417" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="24,22" Spacing="16">
      <Border Classes="preview">
        <TextBlock Text="Prévia: esta tela ainda não fala com o serviço. Cores, efeito e brilho ficam só nesta janela; nada é enviado ao teclado (formato a confirmar no teste A9)." />
      </Border>

      <!-- Desenho do teclado -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Classes="h2" Text="Teclado" />
              <TextBlock Classes="label" Text="Clique numa zona para escolher a cor dela." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Classes="nav" Content="Mesma cor em todas" Command="{Binding ApplyToAllCommand}" IsEnabled="{Binding UsesZoneColors}" />
              <Button Classes="safe" Content="Salvar" Command="{Binding SaveCommand}" IsEnabled="{Binding IsDirty}" />
            </StackPanel>
          </Grid>

          <Border Background="#141417" CornerRadius="10" Padding="10" BorderBrush="{StaticResource KsLineBrush}" BorderThickness="1">
            <ItemsControl ItemsSource="{Binding Zones}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LightZoneViewModel">
                  <Button Classes="zone" Classes.on="{Binding IsSelected}" Command="{Binding SelectCommand}" Margin="3">
                    <StackPanel Margin="6" Spacing="0">
                      <!-- A zona é pintada com a cor; as bordas escuras desenham as teclas por cima -->
                      <Border CornerRadius="4" ClipToBounds="True">
                        <Border.Background><SolidColorBrush Color="{Binding PreviewColor}" /></Border.Background>
                        <ItemsControl ItemsSource="{Binding KeySlots}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:Int32">
                              <Border Classes="key" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Border>
                      <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource KsMutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,16,*">
        <!-- Efeito -->
        <Border Classes="card">
          <StackPanel Spacing="14">
            <TextBlock Classes="h2" Text="Efeito" />
            <ComboBox ItemsSource="{Binding Effects}" SelectedIndex="{Binding EffectIndex}" HorizontalAlignment="Stretch" />
            <TextBlock Classes="label" Text="{Binding EffectHint}" TextWrapping="Wrap" />

            <Grid ColumnDefinitions="90,*,Auto" ColumnSpacing="12" IsEnabled="{Binding !IsOff}">
              <TextBlock Classes="label" Text="Brilho" VerticalAlignment="Center" />
              <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Brightness}" />
              <TextBlock Grid.Column="2" Text="{Binding Brightness, StringFormat='{}{0:0}%'}" VerticalAlignment="Center" Width="44" />
            </Grid>
            <Grid ColumnDefinitions="90,*,Auto" ColumnSpacing="12" IsVisible="{Binding UsesSpeed}">
              <TextBlock Classes="label" Text="Velocidade" VerticalAlignment="Center" />
              <Slider Grid.Column="1" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Speed}" />
              <TextBlock Grid.Column="2" Text="{Binding Speed, StringFormat='{}{0:0}'}" VerticalAlignment="Center" Width="44" />
            </Grid>
            <Grid ColumnDefinitions="90,*" ColumnSpacing="12" IsVisible="{Binding UsesDirection}">
              <TextBlock Classes="label" Text="Direção" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Directions}" SelectedIndex="{Binding DirectionIndex}" HorizontalAlignment="Stretch" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Spacing="2">
                <TextBlock Text="Apagar após 30 s sem uso" />
                <TextBlock Classes="label" Text="Acende de novo ao digitar." />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoOff}" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Cor da zona -->
        <Border Grid.Column="2" Classes="card" IsEnabled="{Binding UsesZoneColors}">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="h2" Text="{Binding SelectedZone.Name, StringFormat='Cor: {0}'}" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding SelectedZone.IsOn}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Palette}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SwatchViewModel">
                  <Button Classes="swatch" Command="{Binding ApplyCommand}" Margin="0,0,8,8">
                    <Button.Background><SolidColorBrush Color="{Binding Color}" /></Button.Background>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="Auto,120,Auto,*" ColumnSpacing="12">
              <TextBlock Classes="label" Text="Hex" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding SelectedZone.Hex}" MaxLength="7" />
              <Border Grid.Column="2" Width="28" Height="28" CornerRadius="6" BorderBrush="{StaticResource KsLineBrush}" BorderThickness="1">
                <Border.Background><SolidColorBrush Color="{Binding SelectedZone.Color}" /></Border.Background>
              </Border>
              <TextBlock Grid.Column="3" Text="Cor inválida (use #RRGGBB)" FontSize="12" Foreground="{StaticResource KsHotBrush}"
                         VerticalAlignment="Center" IsVisible="{Binding SelectedZone.HexIsInvalid}" />
            </Grid>
            <TextBlock Classes="label" TextWrapping="Wrap"
                       Text="Onda e Neon passam por todas as cores; nesses efeitos a cor por zona não é usada." />
          </StackPanel>
        </Border>
      </Grid>

      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource KsWarnBrush}"
                 IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
