<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KillerSense.App.ViewModels"
             x:Class="KillerSense.App.Views.GpuView"
             x:DataType="vm:GpuViewModel">
  <ScrollViewer>
    <StackPanel Margin="24,22" Spacing="16">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4" VerticalAlignment="Center">
          <TextBlock Classes="label" TextWrapping="Wrap"
                     Text="Offset de clock da GPU aplicado em cada modo, na troca de modo, como o PredatorSense faz. O padrão da Acer para este modelo só acelera no Turbo (+100 MHz no núcleo, +200 MHz na memória)." />
          <TextBlock Classes="label" Text="{x:Static vm:GpuViewModel.LimitsText}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="nav" Content="Padrão Acer" Command="{Binding RestoreAcerDefaultsCommand}" HorizontalContentAlignment="Center" />
          <Button Classes="nav" Content="Descartar" Command="{Binding DiscardCommand}" IsEnabled="{Binding IsDirty}" Width="100" HorizontalContentAlignment="Center" />
          <Button Classes="safe" Content="Salvar" Command="{Binding SaveCommand}" IsEnabled="{Binding IsDirty}" />
        </StackPanel>
      </Grid>

      <!-- Liga/desliga -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="4">
              <TextBlock Classes="h2" Text="Aplicar offset por modo" />
              <TextBlock Classes="label" TextWrapping="Wrap"
                         Text="Desligado, o killer-sense não mexe no offset da GPU (e zera o que tiver gravado). Ligado, o serviço grava o offset do modo atual no driver da NVIDIA a cada troca de modo e confere lendo de volta." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled}" VerticalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="8">
            <TextBlock Classes="label" Text="No driver agora" />
            <TextBlock Grid.Column="1" Classes="value" Text="{Binding DriverText}" />
            <TextBlock Grid.Row="1" Classes="label" Text="Alvo no modo atual" />
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding TargetText}" />
          </Grid>
          <TextBlock Text="{Binding LiveNote}" TextWrapping="Wrap" FontSize="12"
                     Foreground="{Binding LiveNoteIsError, Converter={x:Static vm:Converters.ErrorBrush}}"
                     IsVisible="{Binding LiveNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </Border>

      <Border Classes="card" Padding="0">
        <StackPanel>
          <!-- Cabeçalho -->
          <Grid ColumnDefinitions="*,170,170,140" Margin="18,14">
            <TextBlock Classes="label" Text="Modo" />
            <TextBlock Grid.Column="1" Classes="label" Text="Núcleo (MHz)" />
            <TextBlock Grid.Column="2" Classes="label" Text="Memória (MHz)" />
            <TextBlock Grid.Column="3" Classes="label" Text="Padrão Acer" HorizontalAlignment="Right" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GpuOffsetRowViewModel">
                <Border BorderBrush="{StaticResource KsLineBrush}" BorderThickness="0,1,0,0" Padding="18,10">
                  <Grid ColumnDefinitions="*,170,170,140">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Mode}" FontSize="15" />
                      <Border Classes="chip" IsVisible="{Binding IsCurrent}" BorderBrush="{StaticResource KsAccentBrush}" Padding="8,2">
                        <TextBlock Text="atual" FontSize="11" Foreground="{StaticResource KsAccentBrush}" />
                      </Border>
                      <TextBlock Text="alterado" FontSize="11" Foreground="{StaticResource KsWarnBrush}" VerticalAlignment="Center"
                                 IsVisible="{Binding !IsAcerDefault}" />
                    </StackPanel>
                    <NumericUpDown Grid.Column="1" Minimum="{x:Static vm:GpuViewModel.CoreMin}" Maximum="{x:Static vm:GpuViewModel.CoreMax}"
                                   Increment="5" FormatString="+0;-0;0"
                                   Value="{Binding Core}" Width="150" HorizontalAlignment="Left" />
                    <NumericUpDown Grid.Column="2" Minimum="{x:Static vm:GpuViewModel.MemoryMin}" Maximum="{x:Static vm:GpuViewModel.MemoryMax}"
                                   Increment="25" FormatString="+0;-0;0"
                                   Value="{Binding Memory}" Width="150" HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="3" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right">
                      <Run Text="{Binding AcerCore, StringFormat='{}{0:+0;-0;0}'}" />
                      <Run Text=" / " />
                      <Run Text="{Binding AcerMemory, StringFormat='{}{0:+0;-0;0}'}" />
                    </TextBlock>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12"
                 Foreground="{Binding StatusIsError, Converter={x:Static vm:Converters.ErrorBrush}}"
                 IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="h2" Text="Como funciona" />
          <TextBlock Classes="label" TextWrapping="Wrap"
                     Text="O offset vai para o driver da NVIDIA, não para o firmware da Acer. A GPU sobe ou desce o clock pelo mesmo valor em toda a curva; o limite de potência e o de temperatura continuam os do modo." />
          <TextBlock Classes="label" TextWrapping="Wrap"
                     Text="Proteções: o serviço só fala com o driver com a GPU ligada (não a acorda), retira o offset com a GPU a 85 °C ou mais (ou com leitura inválida) até esfriar abaixo de 78 °C, e zera o que gravou ao parar ou ao encerrar o killer-sense. Reiniciar o PC também zera." />
          <TextBlock Classes="label" TextWrapping="Wrap"
                     Text="Offset alto demais pode travar jogos ou mostrar artefatos na imagem. Suba aos poucos e teste em cada passo." />
          <TextBlock Classes="label" TextWrapping="Wrap"
                     Text="Eco não aparece aqui: o padrão da Acer não define offset para ele, e o serviço mantém zero." />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
