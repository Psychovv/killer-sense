<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KillerSense.App.ViewModels"
             xmlns:c="using:KillerSense.App.Controls"
             x:Class="KillerSense.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <ScrollViewer>
    <StackPanel Margin="24,22" Spacing="16">
      <TextBlock Text="{Binding StateDetail}" Classes="label" TextWrapping="Wrap" IsVisible="{Binding StateDetail, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Text="{Binding CommandError}" Foreground="{StaticResource KsHotBrush}" TextWrapping="Wrap" IsVisible="{Binding CommandError, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <Grid ColumnDefinitions="*,16,*">
        <!-- CPU -->
        <Border Classes="card">
          <Grid ColumnDefinitions="190,22,*">
            <Panel Width="190" Height="190">
              <c:Gauge Value="{Binding CpuTemperature}" Maximum="100" Thickness="12"
                       TrackBrush="{StaticResource KsCard2Brush}" ValueBrush="{StaticResource KsAccentBrush}" />
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="label" Text="CPU" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <TextBlock Classes="big" Text="{Binding CpuTemperatureText}" />
                  <TextBlock Classes="label" Text=" °C" FontSize="15" VerticalAlignment="Bottom" Margin="0,0,0,7" />
                </StackPanel>
                <TextBlock Classes="label" Text="i7-14700HX" HorizontalAlignment="Center" />
              </StackPanel>
            </Panel>
            <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" VerticalAlignment="Center" RowSpacing="10">
              <TextBlock Classes="label" Text="Fan" FontSize="14" />
              <TextBlock Grid.Column="1" Classes="value" Text="{Binding CpuFanText}" />
              <TextBlock Grid.Row="1" Classes="label" Text="Rotação" FontSize="14" />
              <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding CpuRpmText}" />
            </Grid>
          </Grid>
        </Border>
        <!-- GPU -->
        <Border Grid.Column="2" Classes="card">
          <Grid ColumnDefinitions="190,22,*">
            <Panel Width="190" Height="190">
              <c:Gauge Value="{Binding GpuTemperature}" Maximum="100" Thickness="12"
                       TrackBrush="{StaticResource KsCard2Brush}" ValueBrush="{StaticResource KsAccent2Brush}" />
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="label" Text="GPU" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <TextBlock Classes="big" Text="{Binding GpuTemperatureText}" />
                  <TextBlock Classes="label" Text=" °C" FontSize="15" VerticalAlignment="Bottom" Margin="0,0,0,7" />
                </StackPanel>
                <TextBlock Classes="label" Text="RTX 4070 Laptop" HorizontalAlignment="Center" />
              </StackPanel>
            </Panel>
            <Grid Grid.Column="2" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" VerticalAlignment="Center" RowSpacing="10">
              <TextBlock Classes="label" Text="Fan" FontSize="14" />
              <TextBlock Grid.Column="1" Classes="value" Text="{Binding GpuFanText}" TextWrapping="Wrap" MaxWidth="170" TextAlignment="Right" />
              <TextBlock Grid.Row="1" Classes="label" Text="Rotação" FontSize="14" />
              <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding GpuRpmText}" />
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- Histórico -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="Últimos 2 minutos (30–100 °C)" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Width="10" Height="3" Background="{StaticResource KsAccentBrush}" VerticalAlignment="Center" />
                <TextBlock Classes="label" Text="CPU" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Width="10" Height="3" Background="{StaticResource KsAccent2Brush}" VerticalAlignment="Center" />
                <TextBlock Classes="label" Text="GPU" />
              </StackPanel>
            </StackPanel>
          </Grid>
          <c:LineChart Height="170" Series="{Binding History}" Minimum="30" Maximum="100" Capacity="120"
                       GridBrush="{StaticResource KsLineBrush}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
