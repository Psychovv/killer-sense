<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KillerSense.App.ViewModels"
        xmlns:v="using:KillerSense.App.Views"
        x:Class="KillerSense.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="killer-sense"
        Icon="/Assets/killer-sense.ico"
        Width="1180" Height="760" MinWidth="960" MinHeight="620">
  <Grid ColumnDefinitions="220,*">

    <!-- Menu lateral -->
    <Border Background="{StaticResource KsSideBrush}" BorderBrush="{StaticResource KsLineBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,22">
        <StackPanel DockPanel.Dock="Top" Margin="10,0,0,22">
          <StackPanel Spacing="-3">
            <TextBlock Classes="wordmark" Text="KILLER" FontSize="19" FontWeight="Bold" />
            <TextBlock Classes="wordmark" Text="SENSE" FontSize="12" FontWeight="SemiBold" LetterSpacing="4" />
          </StackPanel>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Classes="label" Text="{Binding Dashboard.ConnectionText}" TextWrapping="Wrap" Margin="12,0" />
        <ItemsControl ItemsSource="{Binding Pages}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItemViewModel">
              <Button Classes="nav" Classes.on="{Binding IsCurrent}" Command="{Binding SelectCommand}" HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Title}" />
                  <TextBlock Grid.Column="1" Text="prévia" FontSize="10" Foreground="{StaticResource KsWarnBrush}"
                             VerticalAlignment="Center" IsVisible="{Binding IsPreview}" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>

    <!-- Conteúdo -->
    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Top" BorderBrush="{StaticResource KsLineBrush}" BorderThickness="0,0,0,1" Padding="24,16">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
          <TextBlock Classes="h1" Text="{Binding Title}" VerticalAlignment="Center" />
          <Border Grid.Column="1" Classes="chip" Margin="0,0,12,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="label" Text="Modo" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Dashboard.OperatingModeText}" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="chip" Margin="0,0,12,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Width="8" Height="8" Fill="{StaticResource KsAccentBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Dashboard.StateText}" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
            <Button Classes="safe" Content="Retomar" Command="{Binding Dashboard.ResumeCommand}" IsVisible="{Binding Dashboard.IsPaused}" />
            <Button Classes="safe" Content="Voltar ao Auto" Command="{Binding Dashboard.RestoreAutoCommand}" IsEnabled="{Binding Dashboard.IsConnected}" />
          </StackPanel>
        </Grid>
      </Border>

      <ContentControl Content="{Binding CurrentPage}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:DashboardViewModel">
            <v:DashboardView />
          </DataTemplate>
          <DataTemplate DataType="vm:FansViewModel">
            <v:FansView />
          </DataTemplate>
          <DataTemplate DataType="vm:ModesViewModel">
            <v:ModesView />
          </DataTemplate>
          <DataTemplate DataType="vm:ProfilesViewModel">
            <v:ProfilesView />
          </DataTemplate>
          <DataTemplate DataType="vm:BatteryViewModel">
            <v:BatteryView />
          </DataTemplate>
          <DataTemplate DataType="vm:LightingViewModel">
            <v:LightingView />
          </DataTemplate>
          <DataTemplate DataType="vm:KeyboardViewModel">
            <v:KeyboardView />
          </DataTemplate>
          <DataTemplate DataType="vm:GpuViewModel">
            <v:GpuView />
          </DataTemplate>
          <DataTemplate DataType="vm:SettingsViewModel">
            <v:SettingsView />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </DockPanel>
  </Grid>
</Window>
