<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>KillerSense.App</RootNamespace>
    <AssemblyName>KillerSense</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <IsAotCompatible>true</IsAotCompatible>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\killer-sense.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Sem a thread de GC em segundo plano: menos memória parada no modo bandeja. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Publicação: remove do .NET e do Avalonia o que o app não usa (bindings compilados, JSON gerado). -->
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>
  <!-- O desenho é sempre pela CPU (Program.cs): o ANGLE (OpenGL sobre DirectX) nunca é carregado. -->
  <Target Name="KsRemoveAngleFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'av_libglesv2.dll'" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\KillerSense.Core\KillerSense.Core.csproj" />
    <ProjectReference Include="..\KillerSense.Ipc\KillerSense.Ipc.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
</Project>
