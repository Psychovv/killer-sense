<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <RootNamespace>KillerSense.Service</RootNamespace>
    <OutputType>Exe</OutputType>
    <AssemblyName>KillerSense.Service</AssemblyName>
    <!-- Sem a thread de GC em segundo plano: o laço é de 1 s e aloca pouco. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\KillerSense.Core\KillerSense.Core.csproj" />
    <ProjectReference Include="..\KillerSense.Firmware\KillerSense.Firmware.csproj" />
    <ProjectReference Include="..\KillerSense.Gpu\KillerSense.Gpu.csproj" />
    <ProjectReference Include="..\KillerSense.Ipc\KillerSense.Ipc.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
</Project>
